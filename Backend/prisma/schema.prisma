// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The RBAC system is designed to manage user permissions based on their assigned roles. The main entities are User, Role, and Permission, with two join tables: UserRole and RolePermission.
//Look up the User.
//Find all Roles assigned to that user through UserRole.
//For those roles, gather all allowed Permissions through RolePermission.
//Check if the required permission exists in that final list.
model Role {
  id String @id @default(uuid())
  name String @unique
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  roles       RolePermission[]

  createdAt   DateTime @default(now())

  userPermissions UserPermission[]
}

model User {
  id            String   @id @default(uuid())
  employeeId    String   @unique
  firstName     String
  lastName      String
  email         String   @unique
  passwordHash  String
  isActive      Boolean  @default(true)

  roles         UserRole[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  auditLogs AuditLog[]
  userPermissions UserPermission[]
  notifications Notification[]
  
  // BRM relations
  brmsCreated   Brm[] @relation("BrmCreatedBy")
  brmsAssignedTo Brm[] @relation("BrmCurrentPl")
  approvals     BrmApproval[]
  brmHistoryChanges BrmHistory[]
  oldOwnershipHistories BrmOwnershipHistory[] @relation("OldPl")
  newOwnershipHistories BrmOwnershipHistory[] @relation("NewPl")
  ownershipHistoryChanges BrmOwnershipHistory[] @relation("ChangedBy")
  approvalAssignments ApprovalAssignment[]

  brmAssignedBy BrmAssignment[] @relation("AssignedBy")

  brmAssignedTo BrmAssignment[] @relation("AssignedTo")

  userStoriesCreatedBy UserStory[]

  userStoryHistoryChangedBy UserStoryHistory[]

  architectureHistories ArchitectureHistory[]

  tasksCreatedBy Task[]

  taskAssignedBy TaskAssignment[] @relation("TaskAssignedBy")

  taskAssignedTo TaskAssignment[] @relation("TaskAssignedTo")

  taskMilestonesCreatedBy TaskMilestone[]

  taskDependenciesDeclared TaskDependency[]

  taskHistoryChangedBy TaskHistory[]

  qaCycles QaCycle[]

  qaTestScenarios QaTestScenario[]

  qaEvidences QaEvidence[]

  qaHistories QaHistory[]

  securityScans SecurityScan[]

  securityFindingHistories SecurityFindingHistory[]
}

model UserRole {

  userId String

  roleId String

  user User @relation(fields: [userId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  assignedAt DateTime @default(now())

  @@id([userId, roleId]) // composite primary key
}

model RolePermission {

  roleId String

  permissionId String

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId],references: [id] )

  @@id([roleId, permissionId])
}

model UserPermission {

  userId       String
  permissionId String

  user         User @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
}

//aduit the task through the flow and remember the entityType like user,brm and so on
model AuditLog {

  id          String   @id @default(uuid())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  action      String

  entityType  String
  entityId    String

  oldValue    Json?
  newValue    Json?

  ipAddress   String?

  createdAt   DateTime @default(now())
}


















//

// PHASE 1 : PL enters BRM into POTS --> PL sunmits BRM --> HF & HT notified --> SLA starts --> HF & HT approve/reject

// BRM FORM TABLES 
// Brm model for brm details
model Brm {
  id              String   @id @default(uuid())
  brmNumber       String   @unique
  TeamName        String
  Category        String
  title           String
  description     String?
  priority        String?
  currentStatus   BrmStatus

  createdById     String
  createdBy       User @relation("BrmCreatedBy", fields: [createdById], references: [id])

  currentPlId     String
  currentPl       User @relation("BrmCurrentPl", fields: [currentPlId], references: [id])

  submittedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  approvalCycles  BrmApprovalCycle[]
  approvals       BrmApproval[]
  history         BrmHistory[]
  
  ownershipHistory BrmOwnershipHistory[]
  approvalAssignments ApprovalAssignment[]
  

  brmAssignments BrmAssignment[]
  userStory UserStory[]


  architectureTrackings ArchitectureTracking[]

  tasks Task[]

  brmMetrics BrmMetric[]
}


enum BrmStatus {

  DRAFT

  SUBMITTED

  REJECTED

  APPROVED

  USER_STORY_CREATION

  ARCHITECTURE_REVIEW

  READY_FOR_DEVELOPMENT

  CODING_IN_PROGRESS

  READY_FOR_QA

  QA

  SECURITY

  COMPLETED
}


// brm approval model to track the approval process and cycles also
model BrmApproval {
  id                String   @id @default(uuid())
  brmId             String
  approvalCycleId   String
  
  approverId        String
  approver          User @relation(fields: [approverId], references: [id])
  
  approverRole      String
  status            ApprovalStatus
  comments          String?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())

  brm               Brm @relation(fields: [brmId], references: [id])

  cycle BrmApprovalCycle @relation(fields:[approvalCycleId], references:[id])
}

enum ApprovalStatus {

  PENDING

  APPROVED

  REJECTED
}

//brm history model to track the changes in brm status and remarks
model BrmHistory {
  id            String   @id @default(uuid())
  brmId         String
  
  oldStatus     String?
  newStatus     String
  remarks       String?
  
  changedById   String
  changedBy     User @relation(fields: [changedById], references: [id])
  
  createdAt     DateTime @default(now())
  brm           Brm @relation(fields:[brmId], references:[id])
}

// Notification model to send notifications to users about BRM status changes, approvals, and other relevant events.
model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User @relation(fields: [userId], references: [id])
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// BrmOwnershipHistory model to track the changes in BRM ownership like changes in PL (Project Lead) assignments, including the old and new PLs, who made the change, and when it occurred.
model BrmOwnershipHistory {
  id            String @id @default(uuid())
  
  brmId         String
  brm           Brm @relation(fields: [brmId], references: [id])
  
  oldPlId       String
  oldPl         User @relation("OldPl", fields: [oldPlId], references: [id])
  
  newPlId       String
  newPl         User @relation("NewPl", fields: [newPlId], references: [id])
  
  changedById   String
  changedBy     User @relation("ChangedBy", fields: [changedById], references: [id])
  
  changedAt     DateTime @default(now())
}

// approval assignment model to track approvals
model ApprovalAssignment {
  id            String @id @default(uuid())
  
  brmId         String
  brm           Brm @relation(fields: [brmId], references: [id])
  
  approverId    String
  approver      User @relation(fields: [approverId], references: [id])
  
  roleName      String
  assignedAt    DateTime
  dueDate       DateTime
  respondedAt   DateTime?
  isOverdue     Boolean @default(false)
}



// for the management of BRM resubmission
model BrmApprovalCycle {

  id            String   @id @default(uuid())

  brmId         String

  cycleNumber   Int

  status        ApprovalCycleStatus

  startedAt     DateTime

  completedAt   DateTime?

  brm           Brm @relation(fields: [brmId], references: [id])

  approvals     BrmApproval[]
}

enum ApprovalCycleStatus {

  IN_PROGRESS

  APPROVED

  REJECTED
}



















//         SLA TRACKING TABLES       //

// Main SLA Tracking Table - handles all sla types
model SlaTracking {
  id              String   @id @default(uuid())
  
  // Entity identification (polymorphic)
  slaType         SlaType
  entityType      SlaEntityType
  entityId        String
  
  // SLA timeline
  startDate       DateTime
  dueDate         DateTime
  completedDate   DateTime?
  breached        Boolean  @default(false)
  breachedAt      DateTime?
  
  // Additional info
  remarks         String?
  
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt


  
  @@index([entityType, entityId])
  @@index([slaType])
  @@index([dueDate])
  @@index([breached])
}

enum SlaType {
  BRM_REVIEW
  ARCHITECTURE_REVIEW
  TASK_COMPLETION
  QA_REVIEW
  SECURITY_SCAN
}


enum SlaEntityType {
  BRM
  ARCHITECTURE
  TASK
  QA
  SECURITY
}


// Historical SLA performance metrics
model SlaMetric {
  id                String   @id @default(uuid())
  
  entityType        SlaEntityType
  slaType           SlaType
  
  totalSlas         Int       @default(0)
  completedOnTime   Int       @default(0)
  breachedSlas      Int       @default(0)
  
  completionRate    Float     @default(0)  // Percentage
  averageDuration   Int       @default(0)  // in hours
  
  month             Int
  year              Int
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt


  
  @@unique([entityType, slaType, month, year])
  @@index([entityType])
  @@index([slaType])
}






















//PHASE 2 : BRM APPROVED --> PL ASSIGNS TM --> TM CREATES USER STORIES --> PL ASSIGNS TSP TL --> TSP TL CREATES ARCHITECTURE --> GOES FOR CISO APPROVAL IF NEEDED --> TSP TL UPDATES THE STATUS AFTER CISO DECISION



//USED FOR TRACKING THE BRM ASSIGNEMENTS
model BrmAssignment {

  id                String @id @default(uuid())

  brmId             String

  assignmentType    AssignmentType

  assignedById      String
  assignedToId      String

  status            AssignmentStatus

  isCurrent         Boolean @default(true)

  remarks           String?

  assignedAt        DateTime @default(now())

  acceptedAt        DateTime?

  completedAt       DateTime?

  brm               Brm @relation(fields:[brmId],references:[id])

  assignedBy        User @relation("AssignedBy",fields:[assignedById],references:[id])

  assignedTo        User @relation("AssignedTo",fields:[assignedToId],references:[id])

  architectureTrackings ArchitectureTracking[]
}



enum AssignmentType {

  TM

  TSP_TL

  QA

  SECURITY
}



enum AssignmentStatus {

  ASSIGNED

  ACCEPTED

  IN_PROGRESS

  COMPLETED

  REASSIGNED

  CANCELLED
}



model UserStory {

  id              String @id @default(uuid())

  brmId           String

  storyNumber     String @unique

  title           String

  description     String

  priority        String?

  status          UserStoryStatus

  createdById     String

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  brm             Brm @relation(fields:[brmId],references:[id])//NOT ADDED TO BRM

  createdBy       User @relation(fields:[createdById],references:[id])//NOT ADDED YO USER

  history         UserStoryHistory[]
}



enum UserStoryStatus {

  DRAFT

  IN_PROGRESS

  COMPLETED
}




model UserStoryHistory {

  id            String @id @default(uuid())

  userStoryId   String

  oldStatus     String?

  newStatus     String

  remarks       String?

  changedById   String

  createdAt     DateTime @default(now())

  userStory     UserStory @relation(fields:[userStoryId],references:[id])

  changedBy     User @relation(fields:[changedById],references:[id])
}




model ArchitectureTracking {

  id                     String @id @default(uuid())

  brmId                  String

  assignmentId           String

  requiresCisoApproval   Boolean

  status                 ArchitectureStatus

  architectureReceivedAt DateTime?

  submittedToCisoAt      DateTime?

  cisoDecisionAt         DateTime?

  cisoComments           String?

  approvedAt             DateTime?

  remarks                String?

  createdAt              DateTime @default(now())

  updatedAt              DateTime @updatedAt

  brm                    Brm @relation(fields: [brmId], references: [id])
  
  assignment             BrmAssignment @relation(fields: [assignmentId], references: [id])

  architectureHistories ArchitectureHistory[]
}





enum ArchitectureStatus {

  WAITING_FOR_ARCHITECTURE

  ARCHITECTURE_RECEIVED

  SUBMITTED_TO_CISO

  ARCHITECTURE_REJECTED

  READY_FOR_DEVELOPMENT
}



model ArchitectureHistory {

  id                       String @id @default(uuid())

  architectureTrackingId   String

  oldStatus                String?

  newStatus                String

  remarks                  String?

  changedById             String

  createdAt               DateTime @default(now())

  architectureTracking    ArchitectureTracking@relation(fields:[architectureTrackingId],references:[id])// NOT ADDED TO TABLE

  changedBy              User@relation(fields:[changedById],references:[id])//NOT ADDED TO TABLE
}






















//PHASE 3 : READY FOR DEV --> TSP TL CREATES TASK --> TSP TL ASSIGNS IT TO TSP TM --> TSP TM LOGS THE PROGRESS --> AFTER TSAK IS COMPLETED TSP TL ASSIGNS IT TO QA

model Task {

  id              String @id @default(uuid())

  brmId           String

  taskNumber      String @unique

  parentTaskId    String?

  title           String

  description     String

  priority        TaskPriority

  status          TaskStatus

  startDate       DateTime?

  targetEndDate   DateTime?

  actualEndDate   DateTime?

  createdById     String

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  brm             Brm @relation(fields:[brmId],references:[id])

  createdBy       User @relation(fields:[createdById],references:[id])

  taskAssignedTo TaskAssignment[]

  taskMilestones TaskMilestone[]

  taskDependencies    TaskDependency[] @relation("TaskDependencies")

  dependsOnTasks      TaskDependency[] @relation("DependsOnTasks")

  history       TaskHistory[]

  //taskProgressUpdates TaskProgressUpdate[]

  qaCycles QaCycle[]

  securityScans SecurityScan[]

  securityFindings SecurityFinding[]

  taskMetrics TaskMetric[]
}



  

enum TaskPriority {

  Low

  Medium 

  High

}

enum TaskStatus {

  CREATED

  ASSIGNED

  IN_PROGRESS

  BLOCKED

  COMPLETED

  QA_ASSIGNED

  QA_IN_PROGRESS

  QA_DONE

  SECURITY_ASSIGNED

  SECURITY_IN_PROGRESS

  SECURITY_FAILED

  SECURITY_PASSED

  REMEDIATION_REQUIRED
}



model TaskAssignment {

  id              String @id @default(uuid())

  taskId          String

  assignmentType  TaskAssignmentType

  assignedById    String

  assignedToId    String

  status          AssignmentStatus

  isCurrent       Boolean @default(true)

  assignedAt      DateTime @default(now())

  completedAt     DateTime?

  taskAssignedTo            Task @relation(fields:[taskId],references:[id])

  assignedBy                User @relation("TaskAssignedBy",fields:[assignedById],references:[id])  

  assignedTo                User @relation("TaskAssignedTo",fields:[assignedToId],references:[id])
}


enum TaskAssignmentType {

  TSP_TM

  TSP_QA
}


