//PHASE 4: TASK ASSIGNED TO QA --> QA LOGS TEST SCENARIO WITH EVIDENCE --> ALL TASKS QA COMPLETED --> POTS ROUTES THE BRM TO TSP SEC










model QaTestScenario {
  id              String         @id @default(uuid())
  allocationId    String
  scenarioNo      String
  title           String
  description     String
  expectedResult  String
  status          ScenarioStatus @default(NOT_STARTED)
  createdById     String
  createdAt       DateTime       @default(now())

  allocation      TaskAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  createdBy       User           @relation(fields: [createdById], references: [id])
  qaEvidences     QaEvidence[]
}




enum ScenarioStatus {

  NOT_STARTED

  IN_PROGRESS

  PASSED

  FAILED
}


model QaEvidence {

  id              String @id @default(uuid())

  scenarioId      String

  fileName        String

  fileUrl         String

  fileType        EvidenceType

  uploadedById    String

  uploadedAt      DateTime @default(now())

  qaTestScenario   QaTestScenario @relation(fields:[scenarioId],references:[id])

  uploadedBy       User @relation(fields:[uploadedById],references:[id])
}


enum EvidenceType {

  SCREENSHOT

  DOCUMENT
}



model QaHistory {

  id            String @id @default(uuid())

  qaCycleId     String

  oldStatus     String?

  newStatus     String

  remarks       String?

  changedById   String

  createdAt     DateTime @default(now())


  changedBy     User @relation(fields:[changedById],references:[id])
}






























//PHASE 5: TSP SEC SCANS THE TASK --> FINDINGS ARE LOGGED --> IF ANY FINDINGS PRESENT --> REMEDIATION TASK IS CREATED --> 

model SecurityScan {

  id              String @id @default(uuid())

  brmId           String?

  assignedSecId   String

  status          SecurityScanStatus

  scanNumber      Int

  reportUrl       String?

  reportName      String?

  scannedAt       DateTime?

  completedAt     DateTime?

  createdAt       DateTime @default(now())

  brm             Brm? @relation(fields:[brmId],references:[id])

  assignedSec     User @relation(fields:[assignedSecId],references:[id])

  securityFindings SecurityFinding[]


}



enum SecurityScanStatus {

  ASSIGNED

  IN_PROGRESS

  COMPLETED

  FAILED
}


model SecurityFinding {

  id              String @id @default(uuid())

  brmId           String?

  securityScanId  String?


  title           String

  description     String

  severity        FindingSeverity

  status          FindingStatus

  createdAt       DateTime @default(now())

  closedAt        DateTime?

  brm              Brm? @relation(fields:[brmId],references:[id])

  
  securityScan     SecurityScan? @relation(fields:[securityScanId],references:[id])

  securityFindingHistories SecurityFindingHistory[]
}



enum FindingSeverity {

  CRITICAL

  HIGH

  MEDIUM

  LOW
}



enum FindingStatus {

  OPEN

  REMEDIATION_IN_PROGRESS

  CLOSED
}



model SecurityFindingHistory {

  id              String @id @default(uuid())

  findingId       String

  oldStatus       String?

  newStatus       String

  remarks         String?

  changedById     String

  historyfindind  SecurityFinding @relation(fields:[findingId],references:[id])

  changedBy       User @relation(fields:[changedById],references:[id])

  createdAt       DateTime @default(now())
}












