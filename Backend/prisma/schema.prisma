model TaskMilestone {

  id            String @id @default(uuid())

  taskId        String

  title         String

  description   String?

  status        MilestoneStatus

  createdById   String

  createdAt     DateTime @default(now())

  task          Task @relation(fields:[taskId],references:[id])

  createdBy     User @relation(fields:[createdById],references:[id])




}


enum MilestoneStatus {

  PENDING

  COMPLETED
}


model TaskDependency {

  taskId            String

  dependsOnTaskId   String

  declaredById      String

  createdAt         DateTime @default(now())

  task              Task @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOnTask     Task @relation("DependsOnTasks", fields: [dependsOnTaskId], references: [id])
  declaredBy        User @relation(fields: [declaredById], references: [id])

  @@id([taskId, dependsOnTaskId])
}



model TaskHistory {

  id            String @id @default(uuid())

  taskId        String

  oldStatus     String?

  newStatus     String

  remarks       String?

  changedById   String

  createdAt     DateTime @default(now())

  task          Task @relation(fields:[taskId],references:[id])

  changedBy     User @relation(fields:[changedById],references:[id])

}






































//PHASE 4: TASK ASSIGNED TO QA --> QA LOGS TEST SCENARIO WITH EVIDENCE --> ALL TASKS QA COMPLETED --> POTS ROUTES THE BRM TO TSP SEC



model QaCycle {

  id            String @id @default(uuid())

  taskId        String

  assignedQaId  String

  status        QaCycleStatus

  assignedAt    DateTime @default(now())

  completedAt   DateTime?

  task          Task @relation(fields:[taskId],references:[id])

  assignedQa     User @relation(fields:[assignedQaId],references:[id])

  qaTestScenarios QaTestScenario[]

  qaHistories QaHistory[]
}


enum QaCycleStatus {

  ASSIGNED

  IN_PROGRESS

  COMPLETED

  FAILED
}



model QaTestScenario {

  id            String @id @default(uuid())

  qaCycleId     String

  scenarioNo    String

  title         String

  description   String

  expectedResult String

  status        ScenarioStatus

  createdById   String

  createdAt     DateTime @default(now())

  qaCycle       QaCycle @relation(fields:[qaCycleId],references:[id])

  createdBy     User @relation(fields:[createdById],references:[id])

  qaEvidences QaEvidence[]
}



enum ScenarioStatus {

  NOT_STARTED

  IN_PROGRESS

  PASSED

  FAILED
}


model QaEvidence {

  id              String @id @default(uuid())

  scenarioId      String

  fileName        String

  fileUrl         String

  fileType        EvidenceType

  uploadedById    String

  uploadedAt      DateTime @default(now())

  qaTestScenario   QaTestScenario @relation(fields:[scenarioId],references:[id])

  uploadedBy       User @relation(fields:[uploadedById],references:[id])
}


enum EvidenceType {

  SCREENSHOT

  DOCUMENT
}



model QaHistory {

  id            String @id @default(uuid())

  qaCycleId     String

  oldStatus     String?

  newStatus     String

  remarks       String?

  changedById   String

  createdAt     DateTime @default(now())

  qaCycle       QaCycle @relation(fields:[qaCycleId],references:[id])

  changedBy     User @relation(fields:[changedById],references:[id])
}






























//PHASE 5: TSP SEC SCANS THE TASK --> FINDINGS ARE LOGGED --> IF ANY FINDINGS PRESENT --> REMEDIATION TASK IS CREATED --> 

model SecurityScan {

  id              String @id @default(uuid())

  taskId          String

  assignedSecId   String

  status          SecurityScanStatus

  scanNumber      Int

  scannedAt       DateTime?

  completedAt     DateTime?

  createdAt       DateTime @default(now())

  task            Task @relation(fields:[taskId],references:[id])

  assignedSec     User @relation(fields:[assignedSecId],references:[id])

  securityFindings SecurityFinding[]


}



enum SecurityScanStatus {

  ASSIGNED

  IN_PROGRESS

  COMPLETED
}


model SecurityFinding {

  id              String @id @default(uuid())

  securityScanId  String

  taskId          String

  title           String

  description     String

  severity        FindingSeverity

  status          FindingStatus

  createdAt       DateTime @default(now())

  closedAt        DateTime?

  securityFindingTask Task @relation(fields:[taskId],references:[id]) 

  securityScan     SecurityScan @relation(fields:[securityScanId],references:[id])

  securityFindingHistories SecurityFindingHistory[]
}



enum FindingSeverity {

  CRITICAL

  HIGH

  MEDIUM

  LOW
}



enum FindingStatus {

  OPEN

  REMEDIATION_IN_PROGRESS

  CLOSED
}



model SecurityFindingHistory {

  id              String @id @default(uuid())

  findingId       String

  oldStatus       String?

  newStatus       String

  remarks         String?

  changedById     String

  historyfindind  SecurityFinding @relation(fields:[findingId],references:[id])

  changedBy       User @relation(fields:[changedById],references:[id])

  createdAt       DateTime @default(now())
}












