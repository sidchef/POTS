// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The RBAC system is designed to manage user permissions based on their assigned roles. The main entities are User, Role, and Permission, with two join tables: UserRole and RolePermission.
//Look up the User.
//Find all Roles assigned to that user through UserRole.
//For those roles, gather all allowed Permissions through RolePermission.
//Check if the required permission exists in that final list.
model Role {
  id String @id @default(uuid())
  name String @unique
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  roles       RolePermission[]

  createdAt   DateTime @default(now())

  userPermissions UserPermission[]
}

model User {
  id            String   @id @default(uuid())
  employeeId    String   @unique
  firstName     String
  lastName      String
  email         String   @unique
  passwordHash  String
  isActive      Boolean  @default(true)

  roles         UserRole[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  auditLogs AuditLog[]
  userPermissions UserPermission[]
  notifications Notification[]
  
  // BRM relations
  brmsCreated   Brm[] @relation("BrmCreatedBy")
  brmsAssignedTo Brm[] @relation("BrmCurrentPl")
  approvals     BrmApproval[]
  brmHistoryChanges BrmHistory[]
  oldOwnershipHistories BrmOwnershipHistory[] @relation("OldPl")
  newOwnershipHistories BrmOwnershipHistory[] @relation("NewPl")
  ownershipHistoryChanges BrmOwnershipHistory[] @relation("ChangedBy")
  approvalAssignments ApprovalAssignment[]

  brmAssignedBy BrmAssignment[] @relation("AssignedBy")

  brmAssignedTo BrmAssignment[] @relation("AssignedTo")

  userStoriesCreatedBy UserStory[]

  userStoryHistoryChangedBy UserStoryHistory[]

  architectureHistories ArchitectureHistory[]

  qaTestScenarios QaTestScenario[]

  qaEvidences QaEvidence[]

  qaHistories QaHistory[]

  securityScans SecurityScan[]

  securityFindingHistories SecurityFindingHistory[]

  architectureDocs ArchitectureDocument[]

  technologyRequirements TechnologyRequirement[]

  tspMemberProfile TspMemberProfile?

  taskAllocationsAssignedBy TaskAllocation[]

  taskAllocationProgressLogs TaskAllocationProgress[]

    qaAllocations    TaskAllocation[] @relation("QaMemberAllocations")





}

model UserRole {

  userId String

  roleId String

  user User @relation(fields: [userId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  assignedAt DateTime @default(now())

  @@id([userId, roleId]) // composite primary key
}

model RolePermission {

  roleId String

  permissionId String

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId],references: [id] )

  @@id([roleId, permissionId])
}

model UserPermission {

  userId       String
  permissionId String

  user         User @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
}

//aduit the task through the flow and remember the entityType like user,brm and so on
model AuditLog {

  id          String   @id @default(uuid())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  action      String

  entityType  String
  entityId    String

  oldValue    Json?
  newValue    Json?

  ipAddress   String?

  createdAt   DateTime @default(now())
}


















//

// PHASE 1 : PL enters BRM into POTS --> PL sunmits BRM --> HF & HT notified --> SLA starts --> HF & HT approve/reject

// BRM FORM TABLES 
// Brm model for brm details
model Brm {
  id              String   @id @default(uuid())
  brmNumber       String   @unique
  TeamName        String
  Category        String
  title           String
  description     String?
  priority        String?
  currentStatus   BrmStatus

  createdById     String
  createdBy       User @relation("BrmCreatedBy", fields: [createdById], references: [id])

  currentPlId     String
  currentPl       User @relation("BrmCurrentPl", fields: [currentPlId], references: [id])

  submittedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  approvalCycles  BrmApprovalCycle[]
  approvals       BrmApproval[]
  history         BrmHistory[]
  
  ownershipHistory BrmOwnershipHistory[]
  approvalAssignments ApprovalAssignment[]
  

  brmAssignments BrmAssignment[]
  userStory UserStory[]


  architectureTrackings ArchitectureTracking[]

  brmMetrics BrmMetric[]

  architectureDocs ArchitectureDocument[]

  technologyRequirements TechnologyRequirement[]

  taskAllocations TaskAllocation[]

  securityScans    SecurityScan[]
  securityFindings SecurityFinding[]


}


enum BrmStatus {

  DRAFT

  SUBMITTED

  REJECTED

  APPROVED

  USER_STORY_CREATION

  USER_STORIES_CREATED

  ARCHITECTURE_CREATION

  ARCHITECTURE_SUBMITTED

  READY_FOR_DEVELOPMENT

  READY_FOR_TASK_ALLOCATION

  CODING_IN_PROGRESS

  READY_FOR_QA

  QA

  SECURITY

  COMPLETED
}


// brm approval model to track the approval process and cycles also
model BrmApproval {
  id                String   @id @default(uuid())
  brmId             String
  approvalCycleId   String
  
  approverId        String
  approver          User @relation(fields: [approverId], references: [id])
  
  approverRole      String
  status            ApprovalStatus
  comments          String?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())

  brm               Brm @relation(fields: [brmId], references: [id])

  cycle BrmApprovalCycle @relation(fields:[approvalCycleId], references:[id])
}

enum ApprovalStatus {

  PENDING

  APPROVED

  REJECTED
}

//brm history model to track the changes in brm status and remarks
model BrmHistory {
  id            String   @id @default(uuid())
  brmId         String
  
  oldStatus     String?
  newStatus     String
  remarks       String?
  
  changedById   String
  changedBy     User @relation(fields: [changedById], references: [id])
  
  createdAt     DateTime @default(now())
  brm           Brm @relation(fields:[brmId], references:[id])
}

// Notification model to send notifications to users about BRM status changes, approvals, and other relevant events.
model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User @relation(fields: [userId], references: [id])
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// BrmOwnershipHistory model to track the changes in BRM ownership like changes in PL (Project Lead) assignments, including the old and new PLs, who made the change, and when it occurred.
model BrmOwnershipHistory {
  id            String @id @default(uuid())
  
  brmId         String
  brm           Brm @relation(fields: [brmId], references: [id])
  
  oldPlId       String
  oldPl         User @relation("OldPl", fields: [oldPlId], references: [id])
  
  newPlId       String
  newPl         User @relation("NewPl", fields: [newPlId], references: [id])
  
  changedById   String
  changedBy     User @relation("ChangedBy", fields: [changedById], references: [id])
  
  changedAt     DateTime @default(now())
}

// approval assignment model to track approvals
model ApprovalAssignment {
  id            String @id @default(uuid())
  
  brmId         String
  brm           Brm @relation(fields: [brmId], references: [id])
  
  approverId    String
  approver      User @relation(fields: [approverId], references: [id])
  
  roleName      String
  assignedAt    DateTime
  dueDate       DateTime
  respondedAt   DateTime?
  isOverdue     Boolean @default(false)
}



// for the management of BRM resubmission
model BrmApprovalCycle {

  id            String   @id @default(uuid())

  brmId         String

  cycleNumber   Int

  status        ApprovalCycleStatus

  startedAt     DateTime

  completedAt   DateTime?

  brm           Brm @relation(fields: [brmId], references: [id])

  approvals     BrmApproval[]
}

enum ApprovalCycleStatus {

  IN_PROGRESS

  APPROVED

  REJECTED
}



















//         SLA TRACKING TABLES       //

// Main SLA Tracking Table - handles all sla types
model SlaTracking {
  id              String   @id @default(uuid())
  
  // Entity identification (polymorphic)
  slaType         SlaType
  entityType      SlaEntityType
  entityId        String
  
  // SLA timeline
  startDate       DateTime
  dueDate         DateTime
  completedDate   DateTime?
  breached        Boolean  @default(false)
  breachedAt      DateTime?
  
  // Additional info
  remarks         String?
  
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt


  
  @@index([entityType, entityId])
  @@index([slaType])
  @@index([dueDate])
  @@index([breached])
}

enum SlaType {
  BRM_REVIEW
  ARCHITECTURE_REVIEW
  TASK_COMPLETION
  QA_REVIEW
  SECURITY_SCAN
}


enum SlaEntityType {
  BRM
  ARCHITECTURE
  TASK
  QA
  SECURITY
}


// Historical SLA performance metrics
model SlaMetric {
  id                String   @id @default(uuid())
  
  entityType        SlaEntityType
  slaType           SlaType
  
  totalSlas         Int       @default(0)
  completedOnTime   Int       @default(0)
  breachedSlas      Int       @default(0)
  
  completionRate    Float     @default(0)  // Percentage
  averageDuration   Int       @default(0)  // in hours
  
  month             Int
  year              Int
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt


  
  @@unique([entityType, slaType, month, year])
  @@index([entityType])
  @@index([slaType])
}






















//PHASE 2 : BRM APPROVED --> PL ASSIGNS TM --> TM CREATES USER STORIES --> PL ASSIGNS TSP TL --> TSP TL CREATES ARCHITECTURE --> GOES FOR CISO APPROVAL IF NEEDED --> TSP TL UPDATES THE STATUS AFTER CISO DECISION



//USED FOR TRACKING THE BRM ASSIGNEMENTS
model BrmAssignment {

  id                String @id @default(uuid())

  brmId             String

  assignmentType    AssignmentType

  assignedById      String
  assignedToId      String

  status            AssignmentStatus

  isCurrent         Boolean @default(true)

  remarks           String?

  assignedAt        DateTime @default(now())

  acceptedAt        DateTime?

  completedAt       DateTime?

  brm               Brm @relation(fields:[brmId],references:[id])

  assignedBy        User @relation("AssignedBy",fields:[assignedById],references:[id])

  assignedTo        User @relation("AssignedTo",fields:[assignedToId],references:[id])

  architectureTrackings ArchitectureTracking[]
}



enum AssignmentType {

  TM

  TSP_TL

  QA

  SECURITY
}



enum AssignmentStatus {

  ASSIGNED

  ACCEPTED

  IN_PROGRESS

  COMPLETED

  REASSIGNED

  CANCELLED
}



model UserStory {

  id              String @id @default(uuid())

  brmId           String

  storyNumber     String @unique

  title           String

  description     String

  priority        String?

  status          UserStoryStatus

  createdById     String

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  brm             Brm @relation(fields:[brmId],references:[id])//NOT ADDED TO BRM

  createdBy       User @relation(fields:[createdById],references:[id])//NOT ADDED YO USER

  history         UserStoryHistory[]
}



enum UserStoryStatus {

  DRAFT

  IN_PROGRESS

  COMPLETED
}




model UserStoryHistory {

  id            String @id @default(uuid())

  userStoryId   String

  oldStatus     String?

  newStatus     String

  remarks       String?

  changedById   String

  createdAt     DateTime @default(now())

  userStory     UserStory @relation(fields:[userStoryId],references:[id])

  changedBy     User @relation(fields:[changedById],references:[id])
}




model ArchitectureTracking {

  id                     String @id @default(uuid())

  brmId                  String

  assignmentId           String

  requiresCisoApproval   Boolean

  status                 ArchitectureStatus

  architectureReceivedAt DateTime?

  submittedToCisoAt      DateTime?

  cisoDecisionAt         DateTime?

  cisoComments           String?

  approvedAt             DateTime?

  remarks                String?

  createdAt              DateTime @default(now())

  updatedAt              DateTime @updatedAt

  brm                    Brm @relation(fields: [brmId], references: [id])
  
  assignment             BrmAssignment @relation(fields: [assignmentId], references: [id])

  architectureHistories ArchitectureHistory[]
}





enum ArchitectureStatus {

  WAITING_FOR_ARCHITECTURE

  ARCHITECTURE_RECEIVED

  SUBMITTED_TO_CISO

  ARCHITECTURE_REJECTED

  READY_FOR_DEVELOPMENT
}

model ArchitectureDocument {
  id            String   @id @default(uuid())
  brmId         String
  fileName      String
  fileUrl       String
  version       Int      @default(1)
  
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  
  uploadedAt    DateTime @default(now())

  brm           Brm      @relation(fields: [brmId], references: [id])
}



model ArchitectureHistory {

  id                       String @id @default(uuid())

  architectureTrackingId   String

  oldStatus                String?

  newStatus                String

  remarks                  String?

  changedById             String

  createdAt               DateTime @default(now())

  architectureTracking    ArchitectureTracking@relation(fields:[architectureTrackingId],references:[id])// NOT ADDED TO TABLE

  changedBy              User@relation(fields:[changedById],references:[id])//NOT ADDED TO TABLE
}

//Adds technology required for a BRM 
model TechnologyRequirement {
  id              String   @id @default(uuid())
  brmId           String
  
  technologyName  String
  resourceCount   Int
  allocationType  String   // "FULL_TIME" or "SHARED"
  
  submittedById   String
  submittedBy     User     @relation(fields: [submittedById], references: [id])
  
  createdAt       DateTime @default(now())
  brm             Brm      @relation(fields: [brmId], references: [id])
}



model TspMemberProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileNumber String?
  skills       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taskAllocations TaskAllocation[]
}

model TaskAllocation {
  id               String   @id @default(uuid())
  brmId            String
  tspMemberId      String
  skill            String
  taskTitle        String
  taskDescription  String?
  startDate        DateTime
  endDate          DateTime
  status           TaskAllocationStatus @default(ACTIVE)
  assignedById     String
  qaMemberId       String?
  qaMember         User?                @relation("QaMemberAllocations", fields: [qaMemberId], references: [id])


  brm              Brm                @relation(fields: [brmId], references: [id])
  tspMember        TspMemberProfile   @relation(fields: [tspMemberId], references: [id])
  assignedBy       User               @relation(fields: [assignedById], references: [id])

  createdAt        DateTime @default(now())

  milestones     TaskAllocationMilestone[]
  progressLogs   TaskAllocationProgress[]
  qaTestScenarios QaTestScenario[]


}

enum TaskAllocationStatus {
  ACTIVE
  COMPLETED
  QA_TESTING
  QA_COMPLETED
}



model TaskAllocationMilestone {
  id             String   @id @default(uuid())
  allocationId   String
  title          String
  description    String?
  dueDate        DateTime?
  status         MilestoneStatus @default(PENDING)
  createdAt      DateTime @default(now())

  allocation     TaskAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
}

model TaskAllocationProgress {
  id             String   @id @default(uuid())
  allocationId   String
  progressPct    Int      // 0-100
  remarks        String?
  loggedById     String
  createdAt      DateTime @default(now())

  allocation     TaskAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  loggedBy       User           @relation(fields: [loggedById], references: [id])
}



















